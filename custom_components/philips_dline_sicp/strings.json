      "options": {
        "title": "Display options",
        "description": "Sources listed here become the inputs shown in Home Assistant and in HomeKit.",
        "data": {
          "sources": "Inputs",
          "poll_interval": "State refresh interval (seconds, 0 = disabled)",
          "slow_poll_interval": "Settings refresh interval (seconds)",
          "volume_min": "Minimum volume",
          "volume_max": "Maximum volume",
          "volume_step": "Volume step",
          "mac": "MAC address for Wake on LAN (empty = auto-detected)"
        }
      }
